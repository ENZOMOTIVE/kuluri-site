# Copy to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# ── Privy ──────────────────────────────────────────────────────────────────
# Get your App ID from https://console.privy.io → Settings → App ID
# Without this the app runs in mock-auth mode (any login is accepted, a demo wallet is created).
VITE_PRIVY_APP_ID=

# ── Backend API (optional — prototype works without it) ───────────────────
# When set, all service calls (jobs, agreements, …) hit this URL instead of local mock data.
# Example: https://api.kuluri.eu  or  http://localhost:3000
VITE_API_BASE=

# ── Blockchain (Gnosis Chain / Chiado testnet) ────────────────────────────
# Deployed by: cd contracts && npm run deploy:chiado
# Chiado testnet (chain 10200) — free, no real money.
# Switch to chain 100 + mainnet addresses for production.
VITE_CHAIN_ID=10200
VITE_FORWARDER_ADDRESS=
VITE_FACTORY_ADDRESS=

# Private key of the Kuluri relayer wallet — NEVER expose this in the frontend.
# Only used server-side (backend) to pay gas on behalf of users.
# Generate one: node -e "const {Wallet}=require('ethers');console.log(Wallet.createRandom().privateKey)"
DEPLOYER_PRIVATE_KEY=
